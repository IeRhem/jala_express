// use prisma-8

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             temporal.updatedAt()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([identifier])
  @@map("verification")
}

// ── Lookup tables ───────────────────────────────────────────────
// Category and ServiceArea are tables, not enums: ops adds a new
// category or town from the dashboard, not a code deploy. The
// enums further down stay enums because they're branched on in
// application logic — adding a value there needs a code change
// regardless, so a table would only add indirection.

model Category {
  id           String        @id @default(uuid())
  name         String        @unique // "Food", "Electronics", "Rides"
  slug         String        @unique
  active       Boolean       @default(true)
  vendors      VendorCategory[]
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

// A vendor can serve many categories, and a category can have many vendors.
// The explicit join model lets SafeDrop enable/disable a vendor's category
// offering independently and add category-specific terms later.
model VendorCategory {
  vendorId  String
  categoryId String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vendorId, categoryId])
  @@index([categoryId, active])
  @@index([vendorId, active])
}

model ServiceArea {
  id        String   @id @default(uuid())
  name      String   @unique // "Jalingo", "Wukari", "Takum"
  state     String   @default("Taraba")
  active    Boolean  @default(true)
  vendors   Vendor[]
  createdAt DateTime @default(now())
}

// Staff roles join the lookup tables too: adding "Supervisor" or
// splitting "Ops" into "Dispatcher"/"Customer Care" is a dashboard
// action. Note what this does NOT do: a new role row has no
// behavior of its own — permissions, dashboard views, anything
// role-specific still gets written in code. This table only
// removes the need for a migration to add the *label*.
model Role {
  id        String   @id @default(uuid())
  name      String   @unique // "Admin", "Ops", "Rider"
  slug      String   @unique
  active    Boolean  @default(true)
  staff     Staff[]
  createdAt DateTime @default(now())
}

// ── Enums ─────────────────────────────────────────────────────

enum TransactionStatus {
  PENDING_PAYMENT
  HELD
  COLLECTING
  VERIFIED
  REJECTED_AT_PICKUP
  DELIVERED
  CONFIRMED
  REJECTED_AT_DELIVERY
  RELEASED
  REFUNDED
  DISPUTED
  REFUND_PENDING
  PAYOUT_PENDING
  CANCELLED
  EXPIRED
}

enum DeliveryEvidenceType {
  PICKUP_INSPECTION
  DELIVERY_PROOF
  BUYER_DECISION
  OTHER
}

enum DeliveryEvidenceOutcome {
  VERIFIED
  REJECTED
  ACCEPTED
  REJECTED_BY_BUYER
}

enum PaymentType {
  COLLECTION // buyer → SafeDrop, held in escrow
  PAYOUT     // SafeDrop → seller, on release
  REFUND     // SafeDrop → buyer
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  PROCESSING
  REVERSED
}

enum PaymentProvider {
  PAYSTACK // add FLUTTERWAVE etc. here later — no other schema change needed
}

enum EventActorType {
  STAFF  // who, specifically, is on staffId → Staff.role
  BUYER
  SYSTEM
}

// ── People ──────────────────────────────────────────────────────

model Buyer {
  id              String        @id @default(uuid())
  phone           String        @unique // primary identifier — found-or-created on first contact
  contactChannel  String        @default("whatsapp") // how they're currently reached; add more channels later without renaming this field
  name            String?
  userId          String?       @unique // links to a Better Auth User once buyer login exists
  transactions    Transaction[]
  conversations   Conversation[]
  createdAt       DateTime      @default(now())
  updatedAt       temporal.updatedAt()
}

model Vendor {
  id               String        @id @default(uuid())
  businessName     String
  categories       VendorCategory[]
  area             ServiceArea   @relation(fields: [areaId], references: [id])
  areaId           String
  phone            String
  payoutProvider   PaymentProvider @default(PAYSTACK)
  payoutRecipientRef String?     // the provider's recipient/subaccount code — provider named via payoutProvider, not the field name
  userId           String?       @unique // links to a Better Auth User once vendor self-service login exists
  active           Boolean       @default(true)
  transactions     Transaction[]
  createdAt        DateTime      @default(now())
  updatedAt        temporal.updatedAt()
}

// Every person who works for SafeDrop — admin, ops, or rider —
// is one Staff row, distinguished by role. A rider today is just
// a Staff row with role RIDER and no userId yet; the same row
// gains login the day the rider app ships, no migration needed.
model Staff {
  id                String             @id @default(uuid())
  userId            String?            @unique // links to a Better Auth User once this person has login access
  name              String
  phone             String
  role              Role               @relation(fields: [roleId], references: [id])
  roleId            String
  active            Boolean            @default(true)
  transactions      Transaction[]      // transactions where this staff member is the assigned rider
  transactionEvents TransactionEvent[] // every event this staff member performed
  deliveryEvidence  DeliveryEvidence[]
  createdAt         DateTime           @default(now())
  updatedAt         temporal.updatedAt()

  @@index([roleId])
}

// ── Transaction ─────────────────────────────────────────────

model Transaction {
  id              String             @id @default(uuid())
  buyer           Buyer              @relation(fields: [buyerId], references: [id])
  buyerId         String
  vendor          Vendor             @relation(fields: [vendorId], references: [id])
  vendorId        String
  rider           Staff?             @relation(fields: [riderId], references: [id]) // the Staff member (role RIDER) assigned to this transaction
  riderId         String?
  category        Category           @relation(fields: [categoryId], references: [id])
  categoryId      String
  itemDescription String
  amount          Int                // item price in kobo; never use Float for money
  totalAmount     Int?               // total buyer checkout amount in kobo; null means amount for legacy rows
  currency        String             @default("NGN")
  status          TransactionStatus  @default(PENDING_PAYMENT)
  sourceMessageId String?            @unique // WhatsApp wamid that created this deal; prevents duplicate orders
  deliveryAttempt Int                @default(1) // bumped each time a replacement cycle runs
  payments        Payment[]
  events          TransactionEvent[]
  deliveryEvidence DeliveryEvidence[]
  outboxEvents     OutboxEvent[]
  createdAt       DateTime           @default(now())
  updatedAt       temporal.updatedAt()

  @@index([status])
  @@index([buyerId])
  @@index([vendorId])
  @@index([riderId])
  @@index([categoryId])
}

// A Transaction can carry several Payment rows over its life: the
// initial collection, a payout on release, a refund, or a retry
// after a failed attempt — instead of fixed single-payment columns.
model Payment {
  id            String          @id @default(uuid())
  transaction   Transaction     @relation(fields: [transactionId], references: [id])
  transactionId String
  type          PaymentType
  provider      PaymentProvider @default(PAYSTACK)
  reference     String          @unique // internal/provider reference; unique per operation
  checkoutUrl   String?
  providerId    String?         // Paystack transaction/transfer identifier when supplied
  idempotencyKey String?        @unique
  paidAt        DateTime?
  failureReason String?
  amount        Int             // kobo
  status        PaymentStatus   @default(PENDING)
  createdAt     DateTime        @default(now())
  updatedAt     temporal.updatedAt()

  @@index([transactionId])
  @@index([status])
}

// Evidence is separate from status events because one transaction may have
// multiple photos/files across pickup, delivery, and buyer decision stages.
// Store private object keys/metadata here; keep the bucket private and issue
// short-lived signed URLs rather than making evidence publicly accessible.
model DeliveryEvidence {
  id             String                  @id @default(uuid())
  transaction    Transaction             @relation(fields: [transactionId], references: [id])
  transactionId  String
  type           DeliveryEvidenceType
  outcome        DeliveryEvidenceOutcome?
  actorType      EventActorType
  staff          Staff?                  @relation(fields: [staffId], references: [id])
  staffId        String?
  objectKey      String                  // private R2 object key; not a public URL
  originalName   String?
  mimeType       String?
  sizeBytes      Int?
  checksumSha256 String?
  notes          String?
  capturedAt     DateTime?
  createdAt      DateTime                @default(now())

  @@index([transactionId, type, createdAt])
  @@index([staffId])
}

// Every status change, by anyone. actorType is STAFF, BUYER, or
// SYSTEM; when it's STAFF, staffId says who and Staff.role (via
// the Role table) says in what capacity — admin, ops, rider, or
// whatever role gets added later.
model TransactionEvent {
  id            String               @id @default(uuid())
  transaction   Transaction          @relation(fields: [transactionId], references: [id])
  transactionId String
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  outcome       DeliveryEvidenceOutcome? // optional structured outcome for an event
  actorType     EventActorType
  staff         Staff?               @relation(fields: [staffId], references: [id])
  staffId       String?
  notes         String?
  createdAt     DateTime             @default(now())

  @@index([transactionId])
}


enum InboxProvider {
  WHATSAPP
  PAYSTACK
}

enum InboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Conversation {
  id            String   @id @default(uuid())
  buyer         Buyer    @relation(fields: [buyerId], references: [id])
  buyerId       String
  state         String   @default("IDLE") // application-owned state machine
  context       Json?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([buyerId])
  @@index([state, updatedAt])
}

model WebhookInbox {
  id          String       @id @default(uuid())
  provider    InboxProvider
  eventId     String       @unique // WhatsApp wamid or stable Paystack event/reference key
  eventType   String
  payload     Json
  status      InboxStatus  @default(RECEIVED)
  attempts    Int          @default(0)
  lastError   String?
  receivedAt  DateTime     @default(now())
  processedAt DateTime?
  updatedAt   temporal.updatedAt()

  @@index([provider, status, receivedAt])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  transactionId  String?
  kind           String       // e.g. WHATSAPP_TEXT
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  availableAt    DateTime     @default(now())
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()

  @@index([status, availableAt])
}
