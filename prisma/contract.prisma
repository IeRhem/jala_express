// use prisma-8

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     temporal.updatedAt()
  sessions      Session[]
  accounts      Account[]
  staff         Staff?
  buyer         Buyer?
  vendor        Vendor?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             temporal.updatedAt()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  @@index([identifier])
  @@map("verification")
}

// ── Lookup tables ───────────────────────────────────────────────

model Category {
  id           String           @id @default(uuid())
  name         String           @unique // "Food", "Electronics", "Rides"
  slug         String           @unique
  active       Boolean          @default(true)
  vendors      VendorCategory[]
  transactions Transaction[]
  createdAt    DateTime         @default(now())
}

model VendorCategory {
  vendorId   String
  categoryId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  temporal.updatedAt()

  vendor   Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([vendorId, categoryId])
  @@index([categoryId, active])
  @@index([vendorId, active])
}

model ServiceArea {
  id        String   @id @default(uuid())
  name      String   @unique // "Jalingo", "Wukari", "Takum"
  state     String   @default("Taraba")
  active    Boolean  @default(true)
  vendors   Vendor[]
  createdAt DateTime @default(now())
}

model Role {
  id        String   @id @default(uuid())
  name      String   @unique // "Admin", "Ops", "Rider"
  slug      String   @unique
  active    Boolean  @default(true)
  staff     Staff[]
  createdAt DateTime @default(now())
}

// ── Enums ─────────────────────────────────────────────────────

enum TransactionStatus {
  PENDING_PAYMENT
  HELD
  COLLECTING
  VERIFIED
  REJECTED_AT_PICKUP
  DELIVERED
  CONFIRMED
  REJECTED_AT_DELIVERY
  PAYOUT_PENDING
  RELEASED
  REFUND_PENDING
  REFUNDED
  DISPUTED
  CANCELLED
  EXPIRED
}

enum DeliveryEvidenceType {
  PICKUP_INSPECTION
  DELIVERY_PROOF
  BUYER_DECISION
  DISPUTE_EVIDENCE
  OTHER
}

enum DeliveryEvidenceOutcome {
  VERIFIED
  REJECTED
  ACCEPTED
  REJECTED_BY_BUYER
}

enum PaymentType {
  COLLECTION // buyer → SafeDrop, held in escrow
  PAYOUT     // SafeDrop → seller, on release
  REFUND     // SafeDrop → buyer
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PaymentProvider {
  PAYSTACK
}

enum EventActorType {
  STAFF
  BUYER
  SYSTEM
}

// ── People ──────────────────────────────────────────────────────

model Buyer {
  id             String         @id @default(uuid())
  phone          String         @unique
  contactChannel String         @default("whatsapp")
  name           String?
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions   Transaction[]
  conversations  Conversation[]
  createdAt      DateTime       @default(now())
  updatedAt      temporal.updatedAt()
}

model Vendor {
  id                 String           @id @default(uuid())
  businessName       String
  categories         VendorCategory[]
  area               ServiceArea      @relation(fields: [areaId], references: [id])
  areaId             String
  phone              String
  payoutProvider     PaymentProvider  @default(PAYSTACK)
  payoutRecipientRef String?          // Paystack transfer recipient code (e.g. RCP_xxx)
  bankName           String?
  accountNumber      String?
  userId             String?          @unique
  user               User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  active             Boolean          @default(true)
  transactions       Transaction[]
  createdAt          DateTime         @default(now())
  updatedAt          temporal.updatedAt()
}

model Staff {
  id                String             @id @default(uuid())
  userId            String?            @unique
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  name              String
  phone             String             @unique
  role              Role               @relation(fields: [roleId], references: [id])
  roleId            String
  active            Boolean            @default(true)
  transactions      Transaction[]
  transactionEvents TransactionEvent[]
  deliveryEvidence  DeliveryEvidence[]
  createdAt         DateTime           @default(now())
  updatedAt         temporal.updatedAt()

  @@index([roleId])
}

// ── Transaction ─────────────────────────────────────────────

model Transaction {
  id               String             @id @default(uuid())
  buyer            Buyer              @relation(fields: [buyerId], references: [id])
  buyerId          String
  vendor           Vendor             @relation(fields: [vendorId], references: [id])
  vendorId         String
  rider            Staff?             @relation(fields: [riderId], references: [id])
  riderId          String?
  category         Category           @relation(fields: [categoryId], references: [id])
  categoryId       String
  itemDescription  String
  amount           Int                // seller item price in kobo
  escrowFee        Int                @default(0) // SafeDrop platform fee in kobo
  deliveryFee      Int                @default(0) // rider fee in kobo
  totalAmount      Int                // amount + escrowFee + deliveryFee in kobo
  currency         String             @default("NGN")
  status           TransactionStatus  @default(PENDING_PAYMENT)
  sourceMessageId  String?            @unique
  deliveryAttempt  Int                @default(1)
  payments         Payment[]
  events           TransactionEvent[]
  deliveryEvidence DeliveryEvidence[]
  outboxEvents     OutboxEvent[]
  createdAt        DateTime           @default(now())
  updatedAt        temporal.updatedAt()

  @@index([status])
  @@index([buyerId])
  @@index([vendorId])
  @@index([riderId])
  @@index([categoryId])
}

model Payment {
  id             String          @id @default(uuid())
  transaction    Transaction     @relation(fields: [transactionId], references: [id])
  transactionId  String
  type           PaymentType
  provider       PaymentProvider @default(PAYSTACK)
  reference      String          @unique
  checkoutUrl    String?
  providerId     String?
  idempotencyKey String?         @unique
  paidAt         DateTime?
  failureReason  String?
  amount         Int             // kobo
  status         PaymentStatus   @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      temporal.updatedAt()

  @@index([transactionId])
  @@index([status])
}

model DeliveryEvidence {
  id             String                   @id @default(uuid())
  transaction    Transaction              @relation(fields: [transactionId], references: [id])
  transactionId  String
  type           DeliveryEvidenceType
  outcome        DeliveryEvidenceOutcome?
  actorType      EventActorType
  staff          Staff?                   @relation(fields: [staffId], references: [id])
  staffId        String?
  objectKey      String                   // private R2 object key
  originalName   String?
  mimeType       String?
  sizeBytes      Int?
  checksumSha256 String?
  notes          String?
  capturedAt     DateTime?
  createdAt      DateTime                 @default(now())

  @@index([transactionId, type, createdAt])
  @@index([staffId])
}

model TransactionEvent {
  id            String                   @id @default(uuid())
  transaction   Transaction              @relation(fields: [transactionId], references: [id])
  transactionId String
  fromStatus    TransactionStatus?
  toStatus      TransactionStatus
  outcome       DeliveryEvidenceOutcome?
  actorType     EventActorType
  staff         Staff?                   @relation(fields: [staffId], references: [id])
  staffId       String?
  notes         String?
  createdAt     DateTime                 @default(now())

  @@index([transactionId])
}

enum InboxProvider {
  WHATSAPP
  PAYSTACK
}

enum InboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model Conversation {
  id            String   @id @default(uuid())
  buyer         Buyer    @relation(fields: [buyerId], references: [id])
  buyerId       String
  state         String   @default("IDLE")
  context       Json?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     temporal.updatedAt()

  @@unique([buyerId])
  @@index([state, updatedAt])
}

model WebhookInbox {
  id          String        @id @default(uuid())
  provider    InboxProvider
  eventId     String        @unique
  eventType   String
  payload     Json
  status      InboxStatus   @default(RECEIVED)
  attempts    Int           @default(0)
  lastError   String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?
  updatedAt   temporal.updatedAt()

  @@index([provider, status, receivedAt])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  transactionId  String?
  kind           String       // WHATSAPP_TEXT, WHATSAPP_BUTTONS, PAYSTACK_TRANSFER, PAYSTACK_REFUND
  idempotencyKey String       @unique
  payload        Json
  status         OutboxStatus @default(PENDING)
  attempts       Int          @default(0)
  lastError      String?
  availableAt    DateTime     @default(now())
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      temporal.updatedAt()

  @@index([status, availableAt])
}
